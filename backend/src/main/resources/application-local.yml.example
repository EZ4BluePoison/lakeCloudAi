# 本地开发 profile 模板
# 复制为 application-local.yml 后填入真实值，application-local.yml 已加入 .gitignore，不会被提交。

spring:
  datasource:
    username: ${DB_USERNAME:postgres}
    password: ${DB_PASSWORD:your_db_password}
  redis:
    password: ${REDIS_PASSWORD:}

ai:
  wuxidata:
    app-id: ${WUXIDATA_APP_ID:your_app_id}
    app-key: ${WUXIDATA_APP_KEY:your_app_key}

app:
  cors:
    allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:3000}
