# ==============================================================================
# 国联集团 AI 模型服务配置文件
# ==============================================================================
# 此文件包含调用云端AI模型所需的敏感配置信息
# 请将此文件复制为 .env 并填写实际值
# 注意：.env 文件已添加到 .gitignore，不会被提交到代码仓库

# ==============================================================================
# 【必填】API 认证信息
# ==============================================================================
# 您的应用ID（由技术支持分配）
AI_APP_ID=your_app_id_here

# 您的应用密钥（由技术支持分配，绝对保密！）
AI_APP_KEY=your_app_key_here

# 计算后的签名（可选：如果您自己计算）
# 签名算法: MD5(appId + appKey)
# AI_SIGN=your_md5_sign_here

# ==============================================================================
# 【必填】模型选择
# ==============================================================================
# 模型路径标识（从下方可用模型列表中选择）
# 例如: /model/DeepSeek-V32 或 /model/qwen3_32b
AI_MODEL_PATH=/model/DeepSeek-V32

# 模型名称（用于显示）
AI_MODEL_NAME=DeepSeek-V3.2

# ==============================================================================
# 【必填】API 端点配置
# ==============================================================================
# 公网访问地址（适用于外网环境）
# 选择与您的模型对应的地址
AI_API_ENDPOINT=https://glai1.wuxidata.com.cn:9001/v1

# 国联专线地址（适用于内网环境，需要VPN或专线）
# AI_API_ENDPOINT_INTERNAL=https://10.64.251.170:9001/v1

# 是否验证SSL证书（生产环境建议设为true）
AI_VERIFY_SSL=false

# ==============================================================================
# 【可选】模型参数配置
# ==============================================================================
# 温度参数：0-2，值越高随机性越强（推荐: 0.6）
AI_TEMPERATURE=0.6

# 最大输出token数（推荐: 2048）
AI_MAX_TOKENS=2048

# 是否启用流式传输（推荐: true，实时获取响应）
AI_STREAM=true

# 是否启用思考模式（推荐: true，模型会先推理再回答）
AI_ENABLE_THINKING=true

# ==============================================================================
# 可用模型列表（请根据需要修改上方 AI_MODEL_PATH 和 AI_API_ENDPOINT）
# ==============================================================================
# ┌──────────────────────────────────────────────────────────────────────────┐
# │ 模型名称              │ 模型路径标识           │ 公网地址                     │
# ├──────────────────────────────────────────────────────────────────────────┤
# │ DeepSeek-V3.2         │ /model/DeepSeek-V32    │ https://glai1.wuxidata.com.cn:9001/v1  │
# │ Qwen3-Next-80B-A3B    │ /model/Qwen3-Next      │ https://glai2.wuxidata.com.cn:8000/v1  │
# │ Qwen3-32B             │ /model/qwen3_32b       │ https://glai2.wuxidata.com.cn:9001/v1  │
# └──────────────────────────────────────────────────────────────────────────┘
# 
# 【注意】以下模型仅开通专线访问，需使用内网地址:
# - Qwen3-VL-30B: https://10.64.251.169:9004/v1
# - Qwen3-Embedding-4B: https://10.64.251.169:9006/v1
# - Qwen3-Reranker-4B: https://10.64.251.169:9007
# - Qwen3-30B: https://10.64.251.169:9009/v1

# ==============================================================================
# 安全提醒
# ==============================================================================
# 🔒 此文件包含敏感信息，请妥善保管
# 🔒 不要将此文件分享给无关人员
# 🔒 定期轮换 AI_APP_KEY（建议每90天）
# 🔒 如果密钥泄露，请立即联系技术支持吊销
